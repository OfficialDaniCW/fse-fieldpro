# ============================================================
# FSE FieldPro — Environment Variables
# Copy this file to .env.local and fill in your values
# ============================================================

# --- Clerk Authentication ---
# Get from https://dashboard.clerk.com → API Keys
VITE_CLERK_PUBLISHABLE_KEY=pk_test_...

# --- Neon Database ---
# Get from https://console.neon.tech → Project → Connection Details
# Use the "pooled" connection string for API routes
DATABASE_URL=postgresql://user:password@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require

# --- Google Gemini API ---
# Get from https://aistudio.google.com/apikey
GEMINI_API_KEY=AIza...

# --- Cloudflare R2 File Storage ---
# Get from Cloudflare Dashboard → R2 → Manage R2 API Tokens
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=...
R2_SECRET_ACCESS_KEY=...
R2_BUCKET_NAME=fse-fieldpro-uploads
# The public URL for your R2 bucket (enable public access or use custom domain)
R2_PUBLIC_URL=https://pub-xxx.r2.dev
